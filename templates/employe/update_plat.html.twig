{% extends 'base.html.twig' %}

{% block title %}Mise à jour de plat{% endblock %}

{% block body %}
    <div class="container mt-5">
        <h1>Modifier le plat</h1>

        {% for message in app.flashes('success') %}
            <div class="alert alert-success">{{ message }}</div>
        {% endfor %}

        {% if plats.photo %}
            <div class="mb-3">
                <img src="{{ asset('imgs/photoPlats/' ~ plats.photo) }}" alt="Photo du plat" class="img-thumbnail" style="max-width: 200px;">
            </div>
        {% endif %}

        {{ form_start(registrationForm) }}
            {{ form_row(registrationForm.nom) }}
            {{ form_row(registrationForm.photo) }}
            {{ form_row(registrationForm.allergenes) }}
            {{ form_row(registrationForm.disponible) }}
            <button type="submit" class="btn btn-primary mt-3">Modifier le plat</button>
        {{ form_end(registrationForm) }}
    </div>
{% endblock %}