{% extends 'base.html.twig' %}

{% block title %}Créer un menu{% endblock %}

{% block body %}
    <div class="container mt-5">
        <h1>Ajouter un nouveau menu</h1>

        {% for message in app.flashes('success') %}
            <div class="alert alert-success">{{ message }}</div>
        {% endfor %}

        {{ form_start(menuForm) }}
            {{ form_row(menuForm.titre) }}
            {{ form_row(menuForm.description) }}
            {{ form_row(menuForm.prix_personne) }}
            {{ form_row(menuForm.personne_min) }}
            {{ form_row(menuForm.quantite_restante) }}
            {{ form_row(menuForm.regime) }}
            {{ form_row(menuForm.theme) }}
            {{ form_row(menuForm.plats) }}
            <button type="submit" class="btn btn-success mt-3">Créer le menu</button>
        {{ form_end(menuForm) }}
    </div>
{% endblock %}