{% extends 'base.html.twig' %}

{% block title %}Inscription{% endblock %}

{% block stylesheets %}
    {{ parent() }}
    <link rel="stylesheet" href="{{ asset('css/forms.css') }}">
{% endblock %}

{% block body %}
    <div class="auth-wrapper auth-wrapper--top">
        <div class="auth-card auth-card--md">
            <h1>Créer un compte</h1>

            {{ form_errors(registrationForm) }}

            {{ form_start(registrationForm, {'attr': {'class': 'app-form'}}) }}

                <div class="row g-3 mb-3">
                    <div class="col-md-6">
                        {{ form_row(registrationForm.prenom, {attr: {'class': 'form-control'}}) }}
                    </div>
                    <div class="col-md-6">
                        {{ form_row(registrationForm.nom, {attr: {'class': 'form-control'}}) }}
                    </div>
                </div>

                {{ form_row(registrationForm.email, {
                    attr: {'class': 'form-control'}
                }) }}
                {{ form_row(registrationForm.telephone, {
                    attr: {'class': 'form-control'}
                }) }}
                {{ form_row(registrationForm.adresse, {
                    attr: {'class': 'form-control'}
                }) }}
                {{ form_row(registrationForm.plainPassword, {
                    label: 'Mot de passe',
                    attr: {'class': 'form-control'}
                }) }}

                <div class="d-grid mt-4">
                    <button type="submit" class="btn btn-primary btn-lg">S'inscrire</button>
                </div>
            {{ form_end(registrationForm) }}

            <div class="auth-separator">OU</div>

            <div class="auth-links">
                <a href="{{ path('app_login') }}">J'ai déjà un compte</a>
            </div>
        </div>
    </div>
{% endblock %}