{% extends 'base.html.twig' %}

{% block title %}Réinitialiser votre mot de passe{% endblock %}

{% block stylesheets %}
    {{ parent() }}
    <link rel="stylesheet" href="{{ asset('css/forms.css') }}">
{% endblock %}

{% block body %}
    <div class="auth-wrapper">
        <div class="auth-card">
            <h1>Mot de passe oublié</h1>

            {% for flash_error in app.flashes('reset_password_error') %}
                <div class="alert alert-danger" role="alert">{{ flash_error }}</div>
            {% endfor %}

            {{ form_start(requestForm, {'attr': {'class': 'app-form'}}) }}
                <div class="mb-2">
                    {{ form_row(requestForm.email, {
                        attr: {'class': 'form-control'}
                    }) }}
                </div>
                <p class="form-text mb-4">
                    Entrez votre adresse email, et nous vous enverrons un lien pour réinitialiser votre mot de passe.
                </p>

                <div class="d-grid">
                    <button class="btn btn-primary btn-lg">Envoyer</button>
                </div>
            {{ form_end(requestForm) }}

            <div class="auth-links">
                <a href="{{ path('app_login') }}">Retour à la connexion</a>
            </div>
        </div>
    </div>
{% endblock %}