<IfModule mod_rewrite.c>
    RewriteEngine On
    RewriteCond %{REQUEST_URI} !^/public/
    RewriteRule ^(.*)$ /public/$1 [L]
</IfModule>

# Bloque l'accès direct aux fichiers sensibles si jamais la réécriture échoue
<FilesMatch "^\.env">
    Require all denied
</FilesMatch>
<FilesMatch "\.(lock|dist|yaml|yml|json|php\.dist)$">
    <If "%{REQUEST_URI} !~ m#^/public/#">
        Require all denied
    </If>
</FilesMatch>