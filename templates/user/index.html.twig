{% extends 'base.html.twig' %}

{% block title %}Mon compte{% endblock %}

{% block stylesheets %}
    {{ parent() }}
    <link rel="stylesheet" href="{{ asset('css/menus.css') }}">
    <link rel="stylesheet" href="{{ asset('css/compte.css') }}">
{% endblock %}

{% block body %}
    <div class="page-compte">

        <div class="page-header">
            <h1>Mon compte</h1>
            <p class="subtitle">Vos informations et vos commandes, en un coup d'œil</p>
            <span class="divider"></span>
        </div>

        <div class="container pb-5">

            {% for message in app.flashes('success') %}
                <div class="alert alert-success alert-dismissible fade show" role="alert">
                    {{ message }}
                    <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
                </div>
            {% endfor %}

            {% for message in app.flashes('error') %}
                <div class="alert alert-danger alert-dismissible fade show" role="alert">
                    {{ message }}
                    <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
                </div>
            {% endfor %}

            <div class="row">

                {# ===== INFOS UTILISATEUR ===== #}
                <div class="col-lg-4 mb-4">
                    <div class="filtre-card compte-info-card">
                        <h5>Mes informations</h5>

                        <ul class="info-list">
                            <li class="info-row">
                                <span class="info-icon">👤</span>
                                <div>
                                    <span class="info-label">Nom complet</span>
                                    <span class="info-value">{{ user.prenom }} {{ user.nom }}</span>
                                </div>
                            </li>
                            <li class="info-row">
                                <span class="info-icon">✉️</span>
                                <div>
                                    <span class="info-label">Email</span>
                                    <span class="info-value">{{ user.email }}</span>
                                </div>
                            </li>
                            <li class="info-row">
                                <span class="info-icon">📞</span>
                                <div>
                                    <span class="info-label">Téléphone</span>
                                    <span class="info-value">{{ user.telephone ?? 'Non renseigné' }}</span>
                                </div>
                            </li>
                            <li class="info-row">
                                <span class="info-icon">📍</span>
                                <div>
                                    <span class="info-label">Adresse</span>
                                    <span class="info-value">{{ user.adresse ?? 'Non renseignée' }}</span>
                                </div>
                            </li>
                        </ul>

                        <a href="{{ path('app_profile') }}" class="btn btn-primary w-100 justify-content-center mt-3">
                            Modifier mes informations <span class="arrow">→</span>
                        </a>
                    </div>
                </div>

                {# ===== COMMANDES ===== #}
                <div class="col-lg-8">
                    <div class="filtre-card compte-commandes-card">
                        <div class="d-flex justify-content-between align-items-center mb-3">
                            <h5 class="mb-0">Mes commandes</h5>
                            <a href="{{ path('app_nouvelle_commande') }}" class="btn btn-primary">
                                + Nouvelle commande
                            </a>
                        </div>

                        {% if commandes is empty %}
                            <div class="empty-state">
                                <div class="icon-empty">🧾</div>
                                <p>Aucune commande pour le moment.</p>
                            </div>
                        {% else %}
                            <div class="table-responsive">
                                <table class="table table-commandes align-middle">
                                    <thead>
                                        <tr>
                                            <th>Date</th>
                                            <th>Menu</th>
                                            <th>Personnes</th>
                                            <th>Prix</th>
                                            <th>Statut</th>
                                            <th></th>
                                        </tr>
                                    </thead>
                                    <tbody>
                                        {% for commande in commandes %}
                                            {% set statutValue = commande.dernierStatut.statut.value %}
                                            <tr>
                                                <td>{{ commande.dateCommande|date('d/m/Y') }}</td>
                                                <td class="fw-semibold">{{ commande.menu.titre }}</td>
                                                <td>{{ commande.nombrePersonne }}</td>
                                                <td>{{ commande.prixTotal }} €</td>
                                                <td>
                                                    <span class="badge-statut statut-{{ statutValue }}">
                                                        {{ commande.dernierStatut.statut.getLabel }}
                                                    </span>
                                                </td>
                                                <td class="text-end">
                                                    <a href="{{ path('app_detail_commande', {id: commande.id}) }}" class="btn btn-primary btn btn-primary-sm">
                                                        Détails <span class="arrow">→</span>
                                                    </a>
                                                </td>
                                            </tr>
                                        {% endfor %}
                                    </tbody>
                                </table>
                            </div>
                        {% endif %}
                    </div>
                </div>

            </div>
        </div>

    </div>
{% endblock %}