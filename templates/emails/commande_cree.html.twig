<!DOCTYPE html>
<html>
<head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Confirmation de commande</title>
</head>
<body style="margin: 0; padding: 0; background-color: #f4f1ec; font-family: Arial, Helvetica, sans-serif; color: #3a2e28;">
    <table role="presentation" width="100%" cellpadding="0" cellspacing="0" style="background-color: #f4f1ec; padding: 32px 0;">
        <tr>
            <td align="center">
                <table role="presentation" width="600" cellpadding="0" cellspacing="0" style="background-color: #ffffff; border-radius: 8px; overflow: hidden; box-shadow: 0 2px 8px rgba(0,0,0,0.06);">

                    <tr>
                        <td style="background-color: #691b37; padding: 32px; text-align: center;">
                            <h1 style="margin: 0; color: #ffffff; font-size: 22px;">Commande confirmée !</h1>
                            <p style="margin: 8px 0 0; color: #f4d9c6; font-size: 14px;">Vite &amp; Gourmand</p>
                        </td>
                    </tr>

                    <tr>
                        <td style="padding: 32px;">
                            <p style="margin: 0 0 24px; font-size: 15px; line-height: 1.6;">
                                Bonjour {{ commande.user.prenom }},<br>
                                Votre commande <a href="{{ url('app_detail_commande', {id: commande.id}) }}" style="color: #691b37; text-decoration: underline;">#{{ commande.id }}</a> a bien été enregistrée. Voici son récapitulatif :
                            </p>

                            <table role="presentation" width="100%" cellpadding="0" cellspacing="0" style="border: 1px solid #e8e0d8; border-radius: 6px; margin-bottom: 24px;">
                                <tr>
                                    <td style="padding: 16px 20px; border-bottom: 1px solid #e8e0d8;">
                                        <p style="margin: 0 0 4px; font-size: 12px; color: #8a7d74; text-transform: uppercase; letter-spacing: 0.5px;">Menu</p>
                                        <p style="margin: 0; font-size: 16px; font-weight: bold;">{{ menu.titre }}</p>
                                    </td>
                                </tr>
                                <tr>
                                    <td style="padding: 16px 20px; border-bottom: 1px solid #e8e0d8;">
                                        <p style="margin: 0 0 4px; font-size: 12px; color: #8a7d74; text-transform: uppercase; letter-spacing: 0.5px;">Nombre de personnes</p>
                                        <p style="margin: 0; font-size: 15px;">{{ commande.nombrePersonne }}</p>
                                    </td>
                                </tr>
                                <tr>
                                    <td style="padding: 16px 20px; border-bottom: 1px solid #e8e0d8;">
                                        <p style="margin: 0 0 4px; font-size: 12px; color: #8a7d74; text-transform: uppercase; letter-spacing: 0.5px;">Date de livraison</p>
                                        <p style="margin: 0; font-size: 15px;">{{ commande.dateLivraison ? commande.dateLivraison|date('d/m/Y à H:i') : 'Non renseignée' }}</p>
                                    </td>
                                </tr>
                                <tr>
                                    <td style="padding: 16px 20px; border-bottom: 1px solid #e8e0d8;">
                                        <p style="margin: 0 0 4px; font-size: 12px; color: #8a7d74; text-transform: uppercase; letter-spacing: 0.5px;">Adresse de livraison</p>
                                        <p style="margin: 0; font-size: 15px;">{{ commande.adresse }}</p>
                                    </td>
                                </tr>
                                <tr>
                                    <td style="padding: 16px 20px;">
                                        <p style="margin: 0 0 4px; font-size: 12px; color: #8a7d74; text-transform: uppercase; letter-spacing: 0.5px;">Prêt de matériel</p>
                                        <p style="margin: 0; font-size: 15px;">{{ commande.pretMateriel ? 'Oui' : 'Non' }}</p>
                                    </td>
                                </tr>
                            </table>

                            {% if menu.description %}
                                <p style="margin: 0 0 4px; font-size: 12px; color: #8a7d74; text-transform: uppercase; letter-spacing: 0.5px;">Description du menu</p>
                                <p style="margin: 0 0 24px; font-size: 14px; line-height: 1.6;">{{ menu.description }}</p>
                            {% endif %}

                            <p style="margin: 0 0 12px; font-size: 12px; color: #8a7d74; text-transform: uppercase; letter-spacing: 0.5px;">Plats du menu</p>
                            <table role="presentation" width="100%" cellpadding="0" cellspacing="0" style="border: 1px solid #e8e0d8; border-radius: 6px; margin-bottom: 24px;">
                                {% for plat in menu.plats %}
                                    <tr>
                                        <td style="padding: 14px 20px;{% if not loop.last %} border-bottom: 1px solid #e8e0d8;{% endif %}">
                                            <p style="margin: 0 0 4px; font-size: 15px; font-weight: bold;">{{ plat.nom }}</p>
                                            {% if plat.allergenes %}
                                                <p style="margin: 0; font-size: 13px; color: #b45309;">
                                                    ⚠ Allergènes : {{ plat.allergenes }}
                                                </p>
                                            {% else %}
                                                <p style="margin: 0; font-size: 13px; color: #8a7d74;">Aucun allergène signalé</p>
                                            {% endif %}
                                        </td>
                                    </tr>
                                {% endfor %}
                            </table>

                            {% if menu.conditions %}
                                <table role="presentation" width="100%" cellpadding="0" cellspacing="0" style="background-color: #fdf1e6; border-left: 3px solid #9f4500; border-radius: 4px; margin-bottom: 24px;">
                                    <tr>
                                        <td style="padding: 14px 18px;">
                                            <p style="margin: 0 0 4px; font-size: 12px; color: #9f4500; text-transform: uppercase; letter-spacing: 0.5px; font-weight: bold;">Conditions du menu</p>
                                            <p style="margin: 0; font-size: 14px; line-height: 1.5; color: #3a2e28;">{{ menu.conditions }}</p>
                                        </td>
                                    </tr>
                                </table>
                            {% endif %}

                            <table role="presentation" width="100%" cellpadding="0" cellspacing="0" style="background-color: #f4f1ec; border-radius: 6px; margin-bottom: 8px;">
                                <tr>
                                    <td style="padding: 12px 20px; font-size: 14px;">Prix du repas</td>
                                    <td style="padding: 12px 20px; font-size: 14px; text-align: right;">{{ prixRepas|number_format(2, ',', ' ') }} €</td>
                                </tr>
                                <tr>
                                    <td style="padding: 0 20px 12px; font-size: 14px;">
                                        Frais de livraison
                                        {% if livraison.gratuit %}<span style="color: #2e7d32;">(gratuite - {{ livraison.ville }})</span>{% endif %}
                                    </td>
                                    <td style="padding: 0 20px 12px; font-size: 14px; text-align: right;">
                                        {% if livraison.gratuit %}0,00 €{% else %}{{ commande.prixLivraison|number_format(2, ',', ' ') }} €{% endif %}
                                    </td>
                                </tr>
                                <tr>
                                    <td style="padding: 12px 20px; font-size: 16px; font-weight: bold; border-top: 1px solid #e0d5c8;">Total</td>
                                    <td style="padding: 12px 20px; font-size: 16px; font-weight: bold; text-align: right; border-top: 1px solid #e0d5c8; color: #691b37;">
                                        {{ commande.prixTotal|number_format(2, ',', ' ') }} €
                                    </td>
                                </tr>
                            </table>

                            {% if commande.nombrePersonne > menu.personneMin + 4 %}
                                <p style="margin: 16px 0 0; font-size: 13px; color: #2e7d32;">
                                    Une réduction de 10% a été appliquée sur le prix du repas pour cette commande.
                                </p>
                            {% endif %}
                        </td>
                    </tr>

                    <tr>
                        <td style="padding: 24px 32px; background-color: #f4f1ec; border-top: 1px solid #e8e0d8;">
                            <p style="margin: 0; font-size: 15px;">
                                Merci pour votre confiance,<br>
                                <strong>L'équipe Vite &amp; Gourmand</strong>
                            </p>
                        </td>
                    </tr>

                </table>
            </td>
        </tr>
    </table>
</body>
</html>